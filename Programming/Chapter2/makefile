all: run report

run: output
	cd output && cmake ..
	cd output && make
	./output/B
	./output/C
	./output/D
	./output/E || true
	@echo
	cd output && ./F

debug: output
	cd output && cmake -DCMAKE_BUILD_TYPE=DEBUG ..
	cd output && make

report: output run src/report.tex src/references.bib
#complie .tex files generated by output/F.
	@for file in output/*.tex; do \
		pdf_file=$${file%.tex}.pdf; \
		if [ ! -f "$$pdf_file" ]; then \
			pdflatex -output-directory=output "$$file"; \
		fi; \
	done
#compile report.
	cp src/report.tex output/report.tex
	cp src/references.bib output/references.bib
	cd output && pdflatex report.tex
	cd output && bibtex report.aux
	cd output && pdflatex report.tex
	cd output && pdflatex report.tex
	cd output && rm -f report.tex references.bib *.aux *.bbl *.bcf *.blg *.log *.out *.run.xml *.toc *.synctex.gz report-blx.bib
	doxygen Doxyfile
	xdg-open output/html/index.html
	xdg-open output/report.pdf

clean:
	rm -rf output

output:
	mkdir -p output

.PHONY: all run debug report clean output